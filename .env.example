# Copy to .env and fill in. Never commit .env.

# --- API keys (both required) ---
# Gemini API key, from https://aistudio.google.com/apikey. This is the name the AI SDK Google provider reads.
GOOGLE_GENERATIVE_AI_API_KEY=
# Tavily search API key, from https://app.tavily.com.
TAVILY_API_KEY=

# --- Models (optional; these are the defaults, checked against the Gemini model list on 2026-11-11) ---
# Main model: reasoning and the final answer.
MODEL_MAIN=gemini-3.5-flash-lite
# Fast model: query understanding, extraction, titles.
MODEL_FAST=gemini-3.5-flash-lite
# How much the main model reasons before it writes: minimal, low, medium or high. Lower is faster.
THINKING_LEVEL=low
# Note: gemini-3.6-flash gives better answers, but a free-tier Gemini key allows only 20 requests a day
# on it and one question with a web search uses 2 to 4. Set MODEL_MAIN=gemini-3.6-flash if the key has billing.

# --- Settings (optional) ---
PORT=3000
DB_PATH=./data/minimi.db
# Fix "now" for evals, as an ISO time, e.g. 2026-11-11T10:00:00+05:30. Leave empty for the real clock.
CLOCK_OVERRIDE=
